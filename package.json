{
  "name": "attestbook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone, API-first Attestation Rulebook registry and validation platform",
  "packageManager": "bun@1.3.1",
  "engines": {
    "bun": ">=1.3.1"
  },
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun dist/server.js",
    "build": "rm -rf dist && bun build src/server.ts src/validation/schema-sandbox-entry.ts --outdir dist --target bun",
    "test": "bun test src",
    "typecheck": "tsc --noEmit",
    "openapi:check": "bun src/api/openapi-check.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "docs:check": "node scripts/check-docs.mjs && node --test scripts/check-docs.test.mjs"
  },
  "dependencies": {
    "@owf/eudi-attestation-schema": "0.5.4",
    "@sd-jwt/core": "0.24.1",
    "@sd-jwt/sd-jwt-vc": "0.24.1",
    "ajv": "8.20.0",
    "hono": "4.13.16",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@owf/crypto": "0.6.2",
    "@types/bun": "1.3.14",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "@owf/cose": "0.6.2",
    "@owf/crypto": "0.6.2",
    "@owf/identity-common": "0.6.2",
    "@owf/token-status-list": "0.6.2",
    "@sd-jwt/core": "0.24.1",
    "@sd-jwt/sd-jwt-vc": "0.24.1",
    "zod": "4.6.7"
  }
}
