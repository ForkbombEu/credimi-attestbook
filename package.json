{
  "name": "attestbook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone, API-first Attestation Rulebook registry and validation platform",
  "packageManager": "bun@1.3.1",
  "engines": {
    "bun": ">=1.3.1"
  },
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "dev:ui": "vite --config ui/vite.config.ts",
    "start": "bun dist/server.js",
    "build": "rm -rf dist && bun build src/server.ts src/validation/schema-sandbox-entry.ts src/fixtures/fixture-sandbox-entry.ts --outdir dist --target bun && bun run build:ui",
    "build:ui": "vite build --config ui/vite.config.ts",
    "test": "bun test ./src/",
    "test:ui": "vitest run --config ui/vite.config.ts",
    "test:e2e": "playwright test --config ui/playwright.config.ts",
    "acceptance": "bun src/acceptance/cli.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:ui": "tsc --noEmit -p ui/tsconfig.json",
    "openapi:check": "bun src/api/openapi-check.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run typecheck:ui && bun run test && bun run test:ui",
    "docs:check": "node scripts/check-docs.mjs && node --test scripts/check-docs.test.mjs"
  },
  "dependencies": {
    "@owf/eudi-attestation-schema": "0.5.4",
    "@sd-jwt/core": "0.24.1",
    "@sd-jwt/sd-jwt-vc": "0.24.1",
    "ajv": "8.20.0",
    "hono": "4.13.16",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@owf/crypto": "0.6.2",
    "@playwright/test": "1.65.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/bun": "1.3.14",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@owf/cose": "0.6.2",
    "@owf/crypto": "0.6.2",
    "@owf/identity-common": "0.6.2",
    "@owf/token-status-list": "0.6.2",
    "@sd-jwt/core": "0.24.1",
    "@sd-jwt/sd-jwt-vc": "0.24.1",
    "zod": "4.6.7"
  }
}
